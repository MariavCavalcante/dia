# Copie este arquivo para .env (desenvolvimento local) ou configure as mesmas
# chaves nas variáveis de ambiente do Netlify (Site settings → Environment
# variables). Nunca commite um arquivo .env com valores reais.

# URL publicada (Arquivo → Compartilhar → Publicar na web) da Planilha Google
# "DIAGNÓSTICO SITUACIONAL (respostas)" — a URL oficial informada pela
# responsável pelo projeto, já conectada e verificada (ver
# docs/integracao-google-forms.md, seção "Planilha em uso"). Sem esta
# variável, o ambiente de desenvolvimento local usa a planilha de referência
# em scripts/fixtures/planilha-referencia.csv.
GOOGLE_SHEETS_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vQuHw0MOxWL03TS20MzywhAjTtTNTHEE7xWSh_9faIb7fkytQPBSgxtY9ZR32WAnw4biyJGngs09pxv/pub?gid=119176214&single=true&output=csv"

# Token simples para proteger o endpoint /api/revalidar, chamado pelo gatilho
# onFormSubmit do Google Apps Script (ver docs/integracao-google-forms.md).
# Opcional: sem ele, o endpoint aceita qualquer chamada (não expõe dados).
REVALIDATE_TOKEN=

# Intervalo (em milissegundos) de verificação automática no navegador.
# Deve ficar entre 60000 (1 min) e 300000 (5 min) — regra 2.3 do prompt mestre.
VITE_SYNC_INTERVAL_MS=120000

# --- Configuração alternativa: Google Sheets API (planilha restrita) ---
# Preencher apenas se a publicação em CSV for desativada (ver
# docs/integracao-google-forms.md, "Configuração alternativa").
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
